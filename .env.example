# ── Demoer quick-switch: copy to .env and fill in. Env vars only — never code. ──

# Temporal connection
# Set the standard env vars to configure the client connectin
# ref: https://docs.temporal.io/references/client-environment-configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=                # Temporal Cloud (API-key auth; implies TLS)
# TEMPORAL_TLS_CLIENT_CERT_PATH=/path/cert.pem # Temporal Cloud (mTLS) — set both cert and key
# TEMPORAL_TLS_CLIENT_KEY_PATH=/path/key.pem

# Database (docker compose up -d gives you this)
DB_URL=postgresql://demo:demo@localhost:5432/travel

# LLM provider: anthropic (default) | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Checkout demo: on the first checkout attempt, fail the hotel after booking the
# flight so the child visibly compensates with cancel_flight. Later attempts
# succeed; set false to skip the first-attempt failure too.
# CHECKOUT_FAIL_HOTEL=true
# CHECKOUT_STEP_DELAY_SECONDS=1.0
